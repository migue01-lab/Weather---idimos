  <script>
    const IDIOMS_DATA = [
      {
        id: 1,
        idiom: "be a breeze",
        meaning: "to be very easy to do without much effort",
        tag: "Context Cloze",
        prompt: "After practicing every day for a month, the final speaking interview was ________ for Elena.",
        options: [
          "a breeze",
          "on cloud nine",
          "a storm in a teacup",
          "the calm before the storm"
        ],
        correct: "a breeze",
        explanation: "\"Be a breeze\" means something is effortless or very easy. Note the article: we say \"be a breeze\" (noun phrase)."
      },
      {
        id: 2,
        idiom: "be as right as rain",
        meaning: "to feel completely healthy, well, or recovered again",
        tag: "Context Cloze",
        prompt: "You look exhausted right now, but get a good night's sleep and by tomorrow morning you'll ________.",
        options: [
          "be as right as rain",
          "take a rain check",
          "save for a rainy day",
          "chase rainbows"
        ],
        correct: "be as right as rain",
        explanation: "\"Be as right as rain\" means to feel completely well or back to normal, especially after being sick or tired."
      },
      {
        id: 3,
        idiom: "break the ice",
        meaning: "to say or do something to relieve tension and start conversation in a group",
        tag: "Context Cloze",
        prompt: "Nobody knew each other at the workshop, so the facilitator started with a quick game to ________.",
        options: [
          "break the ice",
          "steal their thunder",
          "get wind of it",
          "make a storm in a teacup"
        ],
        correct: "break the ice",
        explanation: "\"Break the ice\" means to make people feel relaxed and comfortable when meeting for the first time."
      },
      {
        id: 4,
        idiom: "it's raining cats and dogs",
        meaning: "it is raining extremely heavily",
        tag: "Situational Match",
        prompt: "We had to cancel the outdoor concert because ________ and the stage was completely flooded.",
        options: [
          "it was raining cats and dogs",
          "it was a breeze",
          "we were chasing rainbows",
          "it was as right as rain"
        ],
        correct: "it was raining cats and dogs",
        explanation: "\"It's raining cats and dogs\" (past: \"it was raining cats and dogs\") is an idiomatic way to describe a torrential downpour."
      },
      {
        id: 5,
        idiom: "calm before the storm",
        meaning: "a quiet, peaceful period right before a time of intense stress, trouble, or busyness",
        tag: "Context Cloze",
        prompt: "The office is surprisingly quiet this Monday morning, but I know it's just the ________ before next week's product launch.",
        options: [
          "calm before the storm",
          "storm in a teacup",
          "rain check",
          "breeze"
        ],
        correct: "calm before the storm",
        explanation: "\"The calm before the storm\" refers to a deceptively peaceful moment right before a chaotic or demanding period."
      },
      {
        id: 6,
        idiom: "chase rainbows",
        meaning: "to pursue unrealistic, impossible, or impractical dreams",
        tag: "Meaning in Context",
        prompt: "His friends warned him he was ________ by quitting his job to become a movie star without any acting experience.",
        options: [
          "chasing rainbows",
          "saving for a rainy day",
          "on cloud nine",
          "breaking the ice"
        ],
        correct: "chasing rainbows",
        explanation: "\"Chase rainbows\" means to waste time pursuing goals that are almost impossible to achieve."
      },
      {
        id: 7,
        idiom: "be on cloud nine",
        meaning: "to feel extremely happy and elated",
        tag: "Context Cloze",
        prompt: "Ever since Marco found out he got the scholarship to study in Canada, he has ________.",
        options: [
          "been on cloud nine",
          "gotten wind of it",
          "stolen someone's thunder",
          "taken a rain check"
        ],
        correct: "been on cloud nine",
        explanation: "\"Be on cloud nine\" expresses extreme happiness or euphoria (present perfect here: \"has been on cloud nine\")."
      },
      {
        id: 8,
        idiom: "steal somebody's thunder",
        meaning: "to take attention or credit away from another person's achievement or announcement",
        tag: "Situational Match",
        prompt: "I was about to announce my promotion at dinner, but my brother ________ by announcing his engagement five minutes earlier.",
        options: [
          "stole my thunder",
          "broke the ice",
          "chased rainbows",
          "was a breeze"
        ],
        correct: "stole my thunder",
        explanation: "\"Steal somebody's thunder\" means to spoil someone's moment of success or take the spotlight away from them."
      },
      {
        id: 9,
        idiom: "make a storm in a teacup",
        meaning: "to exaggerate or make a huge fuss over a minor, unimportant issue",
        tag: "Meaning in Context",
        prompt: "They argued for two hours about who forgot to refill the coffee machine—honestly, they're just ________.",
        options: [
          "making a storm in a teacup",
          "in the calm before the storm",
          "saving for a rainy day",
          "getting wind of it"
        ],
        correct: "making a storm in a teacup",
        explanation: "\"Make a storm in a teacup\" (also \"a tempest in a teapot\" in AmE) means overreacting to something trivial."
      },
      {
        id: 10,
        idiom: "save for a rainy day",
        meaning: "to set aside money or resources for an unexpected future need or emergency",
        tag: "Context Cloze",
        prompt: "Even though her salary increased, Ana prefers to put 15% into her emergency fund to ________.",
        options: [
          "save for a rainy day",
          "take a rain check",
          "be as right as rain",
          "chase rainbows"
        ],
        correct: "save for a rainy day",
        explanation: "\"Save for a rainy day\" means keeping money aside for future hard times or unexpected expenses."
      },
      {
        id: 11,
        idiom: "get wind of",
        meaning: "to hear a rumor or unofficially find out about something secret",
        tag: "Context Cloze",
        prompt: "We wanted the CEO's retirement to be a surprise, but somehow the local press ________ it before the official memo.",
        options: [
          "got wind of",
          "stole the thunder of",
          "broke the ice on",
          "made a breeze of"
        ],
        correct: "got wind of",
        explanation: "\"Get wind of something\" means to learn about something secret or private through rumors or indirect clues."
      },
      {
        id: 12,
        idiom: "take a rain check",
        meaning: "to politely decline an invitation now while asking to do it another time",
        tag: "Situational Match",
        prompt: "I'd love to grab dinner with you tonight, but I have a deadline at 9 p.m.—can I ________ and join you on Friday instead?",
        options: [
          "take a rain check",
          "be as right as rain",
          "save for a rainy day",
          "be on cloud nine"
        ],
        correct: "take a rain check",
        explanation: "\"Take a rain check\" is a polite way to postpone an invitation or offer to a later date."
      }
    ];

    // State
    let activeQuestions = [];
    let currentIndex = 0;
    let score = 0;
    let answered = false;
    let userAnswers = [];
    let studentName = "";

    // DOM Elements
    const screenStart = document.getElementById("screen-start");
    const screenQuiz = document.getElementById("screen-quiz");
    const screenResults = document.getElementById("screen-results");

    const inputName = document.getElementById("student-name");
    const toggleShuffle = document.getElementById("toggle-shuffle");

    const progressLabel = document.getElementById("quiz-progress-label");
    const scoreLabel = document.getElementById("quiz-score-label");
    const progressBar = document.getElementById("quiz-progress-bar");
    const questionTag = document.getElementById("question-tag");
    const questionPrompt = document.getElementById("question-prompt");
    const optionsContainer = document.getElementById("options-container");
    const feedbackBox = document.getElementById("feedback-box");
    const feedbackIcon = document.getElementById("feedback-icon");
    const feedbackTitle = document.getElementById("feedback-title");
    const feedbackText = document.getElementById("feedback-text");
    const nextContainer = document.getElementById("next-container");
    const btnNext = document.getElementById("btn-next");
    const btnNextLabel = document.getElementById("btn-next-label");

    const resultsBadge = document.getElementById("results-badge");
    const resultsHeading = document.getElementById("results-heading");
    const resultsSubtitle = document.getElementById("results-subtitle");
    const resultsScore = document.getElementById("results-score");
    const resultsTotal = document.getElementById("results-total");
    const resultsPercent = document.getElementById("results-percent");
    const resultsMessage = document.getElementById("results-message");
    const btnRetryMissed = document.getElementById("btn-retry-missed");
    const reviewList = document.getElementById("review-list");

    const modalGlossary = document.getElementById("modal-glossary");
    const glossaryItems = document.getElementById("glossary-items");
    const modalQr = document.getElementById("modal-qr");
    const qrTarget = document.getElementById("qr-target");
    const qrUrlDisplay = document.getElementById("qr-url-display");

    function shuffleArray(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function showScreen(target) {
      [screenStart, screenQuiz, screenResults].forEach(s => s.classList.add("hidden"));
      target.classList.remove("hidden");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function startQuiz(questionsSubset = null) {
      studentName = inputName.value.trim();
      const shouldShuffle = toggleShuffle.checked;
      const baseList = questionsSubset || IDIOMS_DATA;
      activeQuestions = (shouldShuffle ? shuffleArray(baseList) : [...baseList]).map(q => ({
        ...q,
        shuffledOptions: shouldShuffle ? shuffleArray(q.options) : [...q.options]
      }));
      currentIndex = 0;
      score = 0;
      userAnswers = [];
      showScreen(screenQuiz);
      renderQuestion();
    }

    function renderQuestion() {
      answered = false;
      const q = activeQuestions[currentIndex];
      const total = activeQuestions.length;

      progressLabel.textContent = `Question ${currentIndex + 1} of ${total}`;
      scoreLabel.textContent = `Score: ${score}`;
      progressBar.style.width = `${((currentIndex + 1) / total) * 100}%`;

      questionTag.textContent = q.tag;
      questionPrompt.textContent = q.prompt;

      feedbackBox.classList.add("hidden");
      nextContainer.classList.add("hidden");
      btnNextLabel.textContent = currentIndex === total - 1 ? "See Results" : "Next Question";

      optionsContainer.innerHTML = "";
      const letters = ["A", "B", "C", "D"];

      q.shuffledOptions.forEach((opt, idx) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "option-btn w-full text-left px-4 py-3.5 rounded-xl border border-slate-200 bg-white hover:border-sky-400 hover:bg-sky-50/50 text-slate-800 font-medium text-sm sm:text-base flex items-center gap-3 min-h-[52px]";
        btn.dataset.option = opt;

        const badge = document.createElement("span");
        badge.className = "w-7 h-7 rounded-lg bg-slate-100 text-slate-600 font-bold text-xs flex items-center justify-center shrink-0";
        badge.textContent = letters[idx];

        const label = document.createElement("span");
        label.className = "flex-1";
        label.textContent = opt;

        btn.appendChild(badge);
        btn.appendChild(label);
        btn.addEventListener("click", () => handleAnswer(opt, btn));
        optionsContainer.appendChild(btn);
      });
    }

    function handleAnswer(selectedOption, clickedBtn) {
      if (answered) return;
      answered = true;

      const q = activeQuestions[currentIndex];
      const isCorrect = selectedOption === q.correct;

      if (isCorrect) {
        score += 1;
        scoreLabel.textContent = `Score: ${score}`;
      }

      userAnswers.push({ item: q, selected: selectedOption, isCorrect });

      const allBtns = optionsContainer.querySelectorAll("button");
      allBtns.forEach(btn => {
        btn.disabled = true;
        const opt = btn.dataset.option;
        const badge = btn.querySelector("span:first-child");

        btn.classList.remove("hover:border-sky-400", "hover:bg-sky-50/50");

        if (opt === q.correct) {
          btn.classList.remove("border-slate-200", "bg-white");
          btn.classList.add("border-emerald-500", "bg-emerald-50", "text-emerald-950");
          badge.classList.remove("bg-slate-100", "text-slate-600");
          badge.classList.add("bg-emerald-600", "text-white");
        } else if (btn === clickedBtn && !isCorrect) {
          btn.classList.remove("border-slate-200", "bg-white");
          btn.classList.add("border-rose-400", "bg-rose-50", "text-rose-950");
          badge.classList.remove("bg-slate-100", "text-slate-600");
          badge.classList.add("bg-rose-600", "text-white");
        } else {
          btn.classList.add("opacity-55");
        }
      });

      feedbackBox.classList.remove("hidden", "bg-emerald-50", "border-emerald-200", "bg-rose-50", "border-rose-200");
      if (isCorrect) {
        feedbackBox.classList.add("bg-emerald-50", "border-emerald-200");
        feedbackIcon.textContent = "✅";
        feedbackTitle.textContent = "Spot on!";
        feedbackTitle.className = "font-bold mb-1 text-emerald-800";
      } else {
        feedbackBox.classList.add("bg-rose-50", "border-rose-200");
        feedbackIcon.textContent = "💡";
        feedbackTitle.textContent = `Not quite — the correct answer is "${q.correct}"`;
        feedbackTitle.className = "font-bold mb-1 text-rose-800";
      }

      feedbackText.textContent = q.explanation;
      nextContainer.classList.remove("hidden");
    }

    function showResults() {
      showScreen(screenResults);
      const total = activeQuestions.length;
      const pct = Math.round((score / total) * 100);

      resultsScore.textContent = score;
      resultsTotal.textContent = `/ ${total}`;
      resultsPercent.textContent = `${pct}%`;

      resultsSubtitle.textContent = studentName
        ? `Great effort, ${studentName}! · Module 22 (B2)`
        : "Module 22 (B2) · Weather Idioms Controlled Practice";

      if (pct === 100) {
        resultsBadge.textContent = "🌟";
        resultsHeading.textContent = "Flawless Score!";
        resultsMessage.textContent = "You nailed every single weather idiom in context. You're ready to use them naturally in speaking!";
      } else if (pct >= 75) {
        resultsBadge.textContent = "🏆";
        resultsHeading.textContent = "Well Done!";
        resultsMessage.textContent = "Strong B2 command of these idioms. Review the ones you missed below to lock them in.";
      } else {
        resultsBadge.textContent = "🌦️";
        resultsHeading.textContent = "Good Practice!";
        resultsMessage.textContent = "Idioms take repetition. Check the explanations below and retry the ones you missed.";
      }

      const missedItems = userAnswers.filter(a => !a.isCorrect).map(a => a.item);
      if (missedItems.length > 0) {
        btnRetryMissed.classList.remove("hidden");
        btnRetryMissed.textContent = `Practice ${missedItems.length} Missed Idiom${missedItems.length > 1 ? "s" : ""}`;
        btnRetryMissed.onclick = () => startQuiz(missedItems);
      } else {
        btnRetryMissed.classList.add("hidden");
      }

      reviewList.innerHTML = "";
      userAnswers.forEach((entry, idx) => {
        const card = document.createElement("div");
        card.className = `p-4 rounded-xl border text-sm ${entry.isCorrect ? "bg-emerald-50/50 border-emerald-200" : "bg-rose-50/50 border-rose-200"}`;

        const header = document.createElement("div");
        header.className = "flex items-center justify-between gap-2 mb-1.5";

        const title = document.createElement("span");
        title.className = "font-bold text-slate-900 capitalize";
        title.textContent = `${idx + 1}. ${entry.item.idiom}`;

        const status = document.createElement("span");
        status.className = `text-xs font-semibold px-2 py-0.5 rounded-full ${entry.isCorrect ? "bg-emerald-100 text-emerald-800" : "bg-rose-100 text-rose-800"}`;
        status.textContent = entry.isCorrect ? "Correct" : `You chose: ${entry.selected}`;

        header.appendChild(title);
        header.appendChild(status);

        const exp = document.createElement("p");
        exp.className = "text-slate-600 text-xs leading-relaxed";
        exp.textContent = entry.item.explanation;

        card.appendChild(header);
        card.appendChild(exp);
        reviewList.appendChild(card);
      });
    }

    function populateGlossary() {
      glossaryItems.innerHTML = "";
      IDIOMS_DATA.forEach((item, i) => {
        const row = document.createElement("div");
        row.className = "p-3 rounded-xl bg-slate-50 border border-slate-200/80";
        const term = document.createElement("p");
        term.className = "font-bold text-slate-900 capitalize";
        term.textContent = `${i + 1}. ${item.idiom}`;
        const def = document.createElement("p");
        def.className = "text-slate-600 text-xs mt-0.5";
        def.textContent = item.meaning;
        row.appendChild(term);
        row.appendChild(def);
        glossaryItems.appendChild(row);
      });
    }

    function openQrModal() {
      modalQr.classList.remove("hidden");
      qrTarget.innerHTML = "";
      const currentUrl = window.location.href;
      const isHttp = currentUrl.startsWith("http://") || currentUrl.startsWith("https://");
      qrUrlDisplay.textContent = isHttp ? currentUrl : "Preview mode — deploy to Vercel to get your live QR URL";

      try {
        if (typeof QRCode !== "undefined" && isHttp) {
          new QRCode(qrTarget, {
            text: currentUrl,
            width: 180,
            height: 180,
            colorDark: "#0f172a",
            colorLight: "#ffffff"
          });
        } else {
          qrTarget.innerHTML = '<div class="text-xs text-slate-500 px-4">Deploy to Vercel to generate a scannable classroom QR code for your live URL.</div>';
        }
      } catch (e) {
        qrTarget.innerHTML = '<div class="text-xs text-slate-500 px-4">QR generator unavailable offline.</div>';
      }
    }

    // Event Listeners
    document.getElementById("btn-start").addEventListener("click", () => startQuiz());
    document.getElementById("btn-restart").addEventListener("click", () => startQuiz());

    btnNext.addEventListener("click", () => {
      if (currentIndex < activeQuestions.length - 1) {
        currentIndex += 1;
        renderQuestion();
      } else {
        showResults();
      }
    });

    document.getElementById("btn-glossary-open").addEventListener("click", () => {
      populateGlossary();
      modalGlossary.classList.remove("hidden");
    });
    document.getElementById("btn-results-glossary").addEventListener("click", () => {
      populateGlossary();
      modalGlossary.classList.remove("hidden");
    });
    document.getElementById("btn-glossary-close").addEventListener("click", () => modalGlossary.classList.add("hidden"));
    modalGlossary.addEventListener("click", (e) => {
      if (e.target === modalGlossary) modalGlossary.classList.add("hidden");
    });

    document.getElementById("btn-qr-open").addEventListener("click", openQrModal);
    document.getElementById("btn-qr-close").addEventListener("click", () => modalQr.classList.add("hidden"));
    modalQr.addEventListener("click", (e) => {
      if (e.target === modalQr) modalQr.classList.add("hidden");
    });
  </script>
</body>
</html>
